FROM mcr.microsoft.com/playwright:v1.61.0-noble@sha256:57b65fdc9ceabe0ef613124c7bbe2babcf9362c4d85e382fe3b03604e84b428a AS proof

ARG UV_VERSION=0.11.23
ARG PIP_VERSION=25.1.1
ARG BUILD_VERSION=1.3.0
ARG TWINE_VERSION=6.1.0
ARG SETUPTOOLS_VERSION=80.9.0
ARG WHEEL_VERSION=0.45.1

LABEL io.spice.release-proof.base.image="mcr.microsoft.com/playwright:v1.61.0-noble" \
      io.spice.release-proof.base.digest="sha256:57b65fdc9ceabe0ef613124c7bbe2babcf9362c4d85e382fe3b03604e84b428a" \
      io.spice.release-proof.playwright.version="1.61.0"

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/tmp/spice-release-proof/home \
    NPM_CONFIG_CACHE=/tmp/spice-release-proof/cache/npm \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    UV_CACHE_DIR=/tmp/spice-release-proof/cache/uv \
    UV_NO_CACHE=1 \
    XDG_CACHE_HOME=/tmp/spice-release-proof/cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        taskwarrior \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages \
        "pip==${PIP_VERSION}" \
        "uv==${UV_VERSION}" \
    && uv pip install --system \
        "build==${BUILD_VERSION}" \
        "setuptools==${SETUPTOOLS_VERSION}" \
        "twine==${TWINE_VERSION}" \
        "wheel==${WHEEL_VERSION}"

RUN mkdir -p /proof/source "$HOME" "$XDG_CACHE_HOME" \
    && chown -R pwuser:pwuser /proof "$HOME" "$XDG_CACHE_HOME"

COPY --chown=pwuser:pwuser . /proof/source

USER pwuser
WORKDIR /proof/source

RUN python3 release-proof/init-source.py /proof/source
RUN npm ci
RUN python3 release-proof/toolchain.py \
    --output .git/release-proof-toolchain.json
RUN python3 release-proof/rehearse.py --artifacts /proof/artifacts

FROM scratch AS artifact_carrier

COPY --from=proof /proof/artifacts/ /artifacts/
